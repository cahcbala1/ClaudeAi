# ============================================================
# SIGO - Variables de entorno del backend
# Copia este archivo como ".env" y reemplaza los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).
# ============================================================

# Modo depuración: 1 = desarrollo, 0 = producción
FLASK_DEBUG=1

# Claves secretas. Genera valores aleatorios con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave
JWT_SECRET_KEY=cambia-esta-otra-clave

# Horas de validez del token de inicio de sesión
JWT_EXPIRES_HOURS=8

# Conexión a PostgreSQL (se configura en la etapa 3)
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgresql://sigo_user:tu_password@localhost:5432/sigo_db

# Administrador inicial que crea "python seed.py" (mínimo 6 caracteres)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave-admin
